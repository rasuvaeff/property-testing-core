<?xml version="1.0"?>
<psalm
    errorLevel="1"
    findUnusedCode="false"
    resolveFromConfigFile="true"
>
    <projectFiles>
        <directory name="src"/>
        <ignoreFiles>
            <directory name="vendor"/>
        </ignoreFiles>
    </projectFiles>
    <!-- PhpRedisCorpusClient types against \Redis; the bundled stub lets psalm
         analyze it without ext-redis being installed. -->
    <enableExtensions>
        <extension name="redis"/>
    </enableExtensions>
    <issueHandlers>
        <!-- \Random\Engine::generate carries the narrow stub contract
             read-props|write-this-props|io, but DrawnEngine is honest about
             doing more: the draw tape is static state (read/write globals)
             and shrinking goes through exception construction (write-refs).
             The implementation cannot fit the interface contract without
             losing the tape; downgraded to info for this file only. -->
        <ImmutableDependency>
            <errorLevel type="info">
                <file name="src/Arbitrary/DrawnEngine.php"/>
            </errorLevel>
        </ImmutableDependency>
    </issueHandlers>
</psalm>
